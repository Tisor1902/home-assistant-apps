{
  "name": "Goon Calendar Sync",
  "version": "0.1.0",
  "slug": "goon_calendar_sync",
  "description": "Verifizierter Goon-Dienstplan mit Google-Kalender- und CalDAV-Synchronisation.",
  "url": "https://github.com/Tisor1902/home-assistant-apps",
  "arch": ["amd64"],
  "startup": "application",
  "boot": "manual",
  "init": true,
  "stage": "experimental",
  "apparmor": true,
  "tmpfs": true,
  "timeout": 30,
  "backup": "cold",
  "ports": { "8080/tcp": 8098 },
  "ports_description": { "8080/tcp": "Passwortgeschützte Goon-Weboberfläche (nur vertrauenswürdiges LAN/VPN)" },
  "webui": "http://[HOST]:[PORT:8080]/",
  "watchdog": "http://[HOST]:[PORT:8080]/health",
  "map": [{ "type": "addon_config", "read_only": true }],
  "options": {
    "godo_username": "",
    "godo_password": "",
    "app_username": "admin",
    "app_password": "",
    "active_instance": false,
    "timezone": "Europe/Berlin",
    "automatic_check_enabled": true,
    "automatic_check_interval_minutes": 720,
    "automatic_past_months": 1,
    "automatic_future_months": 3,
    "public_base_url": "",
    "import_existing_database": false
  },
  "schema": {
    "godo_username": "str",
    "godo_password": "password",
    "app_username": "str",
    "app_password": "password",
    "active_instance": "bool",
    "timezone": "str",
    "automatic_check_enabled": "bool",
    "automatic_check_interval_minutes": "int(15,10080)",
    "automatic_past_months": "int(0,12)",
    "automatic_future_months": "int(0,24)",
    "public_base_url": "str?",
    "import_existing_database": "bool"
  }
}
